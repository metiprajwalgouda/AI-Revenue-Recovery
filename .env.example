# Razorpay Test Mode API Credentials (Required for payment link generation and orders)
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere

# Razorpay Webhook Secret (Optional — for verifying incoming webhook signatures)
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Resend API Key (Optional — for sending recovery and dunning emails)
RESEND_API_KEY=re_yourResendApiKeyHere

# Google Gemini API Key (Primary LLM classifier for ambiguous checkout events)
GEMINI_API_KEY=yourGeminiApiKeyHere

# Anthropic Claude API Key (Fallback LLM classifier for quota/429 fallback and batch evaluation)
ANTHROPIC_API_KEY=sk-ant-yourAnthropicApiKeyHere

# Centralized LLM Model Overrides (Optional)
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Twilio Credentials (Optional — for automated voice calls, SMS, and WhatsApp alerts)
TWILIO_ACCOUNT_SID=ACyourTwilioAccountSidHere
TWILIO_AUTH_TOKEN=yourTwilioAuthTokenHere
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Exotel Voice Credentials (Optional — alternative voice provider for Indian local telephony)
EXOTEL_API_KEY=yourExotelApiKeyHere
EXOTEL_API_TOKEN=yourExotelApiTokenHere
EXOTEL_SID=yourExotelSidHere
EXOTEL_PHONE_NUMBER=08047000000
EXOTEL_API_DOMAIN=api.exotel.com
EXOTEL_APP_ID=yourExotelAppIdHere

# Telephony Voice Provider Selection ('twilio' or 'exotel')
RECOVERY_CALL_PROVIDER=twilio

# Simulation & Mock Mode Toggles (Set to false for real API outreach, true for local offline simulation)
MOCK_PAYMENTS=false
MOCK_CALLS=false
MOCK_SMS_FIXED=false
RECOVERY_MODE=live

# Server Host & Base URL Configuration (Use public ngrok/tunnel URL for Webhooks/TwiML redirects)
PUBLIC_APP_URL=https://your-public-ngrok-or-domain.ngrok-free.dev
APP_BASE_URL=http://localhost:8001
PORT=8001

# Session Security & Application Settings
SESSION_SECRET_KEY=dev-only-insecure-secret-change-in-env
DUNNING_POLL_INTERVAL_SECONDS=120